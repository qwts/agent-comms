#!/usr/bin/env bash
# Prepare a release PR for agent-comms.
#
# Bumps every version site together (package.json, package-lock.json, the
# CLI's VERSION, the skill's qwts-validated, the formula's tag and version)
# and dates the CHANGELOG's Unreleased section, so the drift check in tests/version.test.mjs
# stays green. It does not commit, tag, or push: open a PR with the result.
# When that PR merges and CI passes on main, the Release workflow tags the
# merged commit vX.Y.Z and publishes the GitHub release. Agents never push
# tags or default-branch commits.
#
#   scripts/release X.Y.Z
#
# A version outside the skill's qwts-versions is refused before any change
# (ENG-0055): leaving the range needs a reviewed skill revalidation first.
set -euo pipefail

version="${1:-}"
version="${version#v}"
if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "Usage: scripts/release X.Y.Z" >&2
    exit 1
fi

root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
skill="$root/skills/agent-comms/SKILL.md"
formula="$root/Formula/agent-comms.rb"
changelog="$root/CHANGELOG.md"
cli="$root/bin/agent-comms.mjs"
for file in "$root/package.json" "$cli" "$skill" "$formula" "$changelog"; do
    if [[ -z "$root" || ! -f "$file" ]]; then
        echo "Error: run from inside an agent-comms checkout (missing ${file#"$root"/})" >&2
        exit 1
    fi
done
cd "$root"

if [[ -n "$(git status --porcelain)" ]]; then
    echo "Error: working tree must be clean to prepare a release" >&2
    exit 1
fi
# A tag that exists only on the remote would make the Release workflow skip
# this version silently, so check there too.
if git rev-parse -q --verify "refs/tags/v$version" >/dev/null \
    || git ls-remote --exit-code --tags origin "refs/tags/v$version" >/dev/null 2>&1; then
    echo "Error: tag v$version already exists" >&2
    exit 1
fi

# The skill keeps qwts-versions in the bounded form ">=A.B.C <D.E.F", so the
# range check needs no SemVer library.
semver_cmp() {
    local a b i
    IFS=. read -r -a a <<<"$1"
    IFS=. read -r -a b <<<"$2"
    for i in 0 1 2; do
        (( a[i] < b[i] )) && { echo -1; return; }
        (( a[i] > b[i] )) && { echo 1; return; }
    done
    echo 0
}
range="$(sed -nE 's/^[[:space:]]*qwts-versions:[[:space:]]*"([^"]*)"[[:space:]]*$/\1/p' "$skill" | head -1)"
if [[ ! "$range" =~ ^\>=([0-9]+\.[0-9]+\.[0-9]+)\ \<([0-9]+\.[0-9]+\.[0-9]+)$ ]]; then
    echo "Error: $skill must declare qwts-versions as \">=A.B.C <D.E.F\" (got '${range:-<missing>}')" >&2
    exit 1
fi
if [[ "$(semver_cmp "$version" "${BASH_REMATCH[1]}")" == -1 || "$(semver_cmp "$version" "${BASH_REMATCH[2]}")" != -1 ]]; then
    echo "Error: $version is outside the skill's qwts-versions ($range); revalidate the skill in a reviewed PR first (ENG-0055)" >&2
    exit 1
fi

if ! grep -q '^## \[Unreleased\]' "$changelog"; then
    echo "Error: CHANGELOG.md has no '## [Unreleased]' section to release" >&2
    exit 1
fi

npm version "$version" --no-git-tag-version --allow-same-version >/dev/null
sed -i.bak -E "s/^(const VERSION = ')[0-9]+\.[0-9]+\.[0-9]+(';)/\1${version}\2/" "$cli"
sed -i.bak -E "s/^([[:space:]]*qwts-validated:[[:space:]]*\")[0-9]+\.[0-9]+\.[0-9]+(\")/\1${version}\2/" "$skill"
sed -i.bak -E "s/^([[:space:]]*tag:[[:space:]]*\")v[0-9]+\.[0-9]+\.[0-9]+(\")/\1v${version}\2/" "$formula"
sed -i.bak -E "s/^([[:space:]]*version \")[0-9]+\.[0-9]+\.[0-9]+(\")/\1${version}\2/" "$formula"
rm -f "$cli.bak" "$skill.bak" "$formula.bak"
# BSD sed cannot insert a newline in a replacement, so date the section in node.
node -e '
const fs = require("node:fs");
const [file, version, date] = process.argv.slice(1);
fs.writeFileSync(file, fs.readFileSync(file, "utf8")
  .replace(/^## \[Unreleased\].*$/m, `## [Unreleased]\n\n## [${version}] - ${date}`));
' "$changelog" "$version" "$(date -u +%Y-%m-%d)"

# Each rewrite must have matched: a sed that matches nothing exits 0.
for check in "$cli:const VERSION = '$version';" "$skill:qwts-validated: \"$version\"" "$formula:tag:   \"v$version\"" "$formula:version \"$version\"" "$changelog:## [$version] - "; do
    if ! grep -qF "${check#*:}" "${check%%:*}"; then
        echo "Error: could not set the version in ${check%%:*}; fix it by hand" >&2
        exit 1
    fi
done
node --test tests/version.test.mjs >/dev/null
echo "Prepared v$version. Review the diff, then open a release PR; CI tags v$version after it merges."
